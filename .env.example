# Phase 1 — no backend credentials required.
# Home/auth stay mock unless EXPO_PUBLIC_DATA_SOURCE=live.
# Racing always syncs Champ Drifter Path from this origin's /push APIs only.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_PUSH_ORIGIN=https://akacademy.online

# Used only when EXPO_PUBLIC_DATA_SOURCE=live (Phase 2+)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
